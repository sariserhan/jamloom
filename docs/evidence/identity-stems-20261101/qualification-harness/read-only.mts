import '../apps/site/scripts/env';
import {writeFile,readFile} from 'node:fs/promises';
import {api as apple} from '../build-launch-preparation-20261031/apple-api.mjs';
const dir=new URL('./',import.meta.url),endpoint='jl77hn92npt65k';
const save=async(name:string,x:any)=>writeFile(new URL(name,dir),JSON.stringify(x,null,2)+'\n',{mode:0o600});
async function get(url:string){const r=await fetch(url,{headers:{Authorization:'Bearer '+process.env.RUNPOD_API_KEY},signal:AbortSignal.timeout(20000)});if(!r.ok){await r.body?.cancel();throw Error('Read-only provider HTTP '+r.status);}return r.json();}
const tasks=[
async()=>{const e=await get('https://api.runpod.io/v2/serverless/'+endpoint);const h=await get('https://api.runpod.ai/v2/'+endpoint+'/health');const c=await get('https://api.runpod.io/v2/catalog/gpus');const result={at:new Date().toISOString(),mutations:false,endpoint:{id:e.id,image:e.image,type:e.type,disk:e.disk,gpu:e.gpu,workers:e.workers,scaling:e.scaling,flashboot:e.flashboot,locations:e.locations,executionTimeoutMs:e.executionTimeoutMs,templateId:e.templateId},health:h,gpuCatalog:c.gpus?.filter((g:any)=>['NVIDIA L4','NVIDIA RTX A5000','NVIDIA RTX 4000 Ada Generation','NVIDIA L40S','NVIDIA GeForce RTX 4090'].includes(g.id))};await save('provider-readonly.json',result);console.log(JSON.stringify({section:'provider',...result}));},
async()=>{const v=await apple('/v1/apps/6826480059/appStoreVersions?filter[platform]=IOS&limit=10');const s=await apple('/v1/reviewSubmissions?filter[app]=6826480059&limit=10');const versions=[];for(const x of v.data??[]){const b=await apple('/v1/appStoreVersions/'+x.id+'/build');versions.push({id:x.id,version:x.attributes.versionString,state:x.attributes.appStoreState,releaseType:x.attributes.releaseType,build:b.data?{version:b.data.attributes.version,processingState:b.data.attributes.processingState}:null});}const r={at:new Date().toISOString(),mutations:false,versions,submissions:s.data?.map((x:any)=>({id:x.id,state:x.attributes.state,submittedDate:x.attributes.submittedDate}))};await save('apple-readonly.json',r);console.log(JSON.stringify({section:'apple',...r}));},
async()=>{const p=new URLSearchParams({serverlessId:endpoint,bucketSize:'hour',startTime:'2026-11-02T00:00:00.000Z',endTime:new Date().toISOString()});const b=await get('https://api.runpod.io/v2/billing/serverless?'+p);const r={at:new Date().toISOString(),mutations:false,finalInvoice:false,missingRowsAreNotZero:true,receipt:b};await save('latest-endpoint-billing.json',r);console.log(JSON.stringify({section:'billing',records:b.records?.length,totals:b.metadata?.totals,finalInvoice:false}));}
];
for(const [i,t] of tasks.entries()){try{await t();}catch(e){const r={section:i,status:'READ_FAILED',message:e instanceof Error?e.message:'unknown'};await save('read-error-'+i+'.json',r);console.log(JSON.stringify(r));}}
