import '../apps/site/scripts/env';import {writeFile} from 'node:fs/promises';
const from='2026-10-31T00:00:00.000Z',to=new Date().toISOString();
const query=`query($input: UserBillingInput!, $from: DateTime!, $to: DateTime!) { myself { clientBalance currentSpendPerHr underBalance maxServerlessConcurrency dailyCharges(startDate:$from,endDate:$to) { amount updatedAt diskCharges podCharges apiCharges serverlessCharges type } billing(input:$input) { serverless(input:{groupBy:INSTANCE_ID}) { time amount timeBilledSeconds endpointId gpuTypeId instanceId slsWorkerType } storage { time slsStorageAmount slsDiskSpaceBilledGB } } } }`;
const r=await fetch('https://api.runpod.io/graphql',{method:'POST',headers:{Authorization:'Bearer '+process.env.RUNPOD_API_KEY,'Content-Type':'application/json'},body:JSON.stringify({query,variables:{from,to,input:{granularity:'HOURLY',startDate:from,endDate:to}}}),signal:AbortSignal.timeout(20000)});const j=await r.json();const report={at:new Date().toISOString(),mutations:false,status:r.status,finalInvoice:false,from,to,data:j.data,errors:j.errors?.map((e:any)=>e.message)};await writeFile(new URL('billing-private.json',import.meta.url),JSON.stringify(report,null,2)+'\n',{mode:0o600});
console.log(JSON.stringify({status:r.status,errors:report.errors,rows:j.data?.myself?.billing?.serverless?.length,dailyRows:j.data?.myself?.dailyCharges?.length,underBalance:j.data?.myself?.underBalance,currentSpendPerHr:j.data?.myself?.currentSpendPerHr}));
