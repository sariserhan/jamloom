import {database,control,health,read,save,endpoint} from './deployed-common.mts';
const pool=database();try{const p=await read('permit.json');const [e,h,rows,g]=await Promise.all([control('serverless/'+endpoint),health(),pool.query('SELECT state,reason,starts_at,expires_at,ready_at,busy_at FROM cloud_capacity_cycles WHERE permit_id=$1',[p.id]),pool.query('SELECT checked_at FROM cloud_capacity_guardians WHERE endpoint=$1',[endpoint])]);const result={at:new Date().toISOString(),workers:e.workers,health:h,cycles:rows.rows,guardianAgeMs:g.rows[0]?Date.now()-Number(g.rows[0].checked_at):null};await save('latest-observation.json',result);console.log(JSON.stringify(result,(_k,v)=>typeof v==='bigint'?Number(v):v));}finally{await pool.end();}
