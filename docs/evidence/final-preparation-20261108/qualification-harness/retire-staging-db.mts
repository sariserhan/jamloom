import '../apps/site/scripts/env';
import assert from 'node:assert/strict';
import {readFile,writeFile,chmod} from 'node:fs/promises';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
import {createPool} from '../apps/site/lib/database';
const dir=new URL('./',import.meta.url),read=async(n:string)=>JSON.parse(await readFile(new URL(n,dir),'utf8'));
assert.equal((await read('style-cleanup.json')).status,'PASS');assert.equal((await read('guardian-restored.json')).status,'PASS');assert.equal((await read('staging-deployments-removed.json')).status,'PASS');
const stage=await read('staging-database-private.json'),u=new URL(stage.direct);assert.equal(u.pathname,'/jamloom_stage_20261108');assert(u.hostname.endsWith('.neon.tech'));
const pool=createPool(u.href);let counts;try{assert.equal((await pool.query("SELECT count(*)::int n FROM cloud_capacity_cycles WHERE state!='stopped'")).rows[0].n,0);assert.equal((await pool.query("SELECT count(*)::int n FROM dna_song_jobs WHERE state IN ('queued','running')")).rows[0].n,0);counts=(await pool.query('SELECT (SELECT count(*)::int FROM dna_song_jobs) songs,(SELECT count(*)::int FROM wallet_ledger_entries) ledger')).rows[0];}finally{await pool.end();}
const archive=new URL('staging-database-private.dump',dir);await writeFile(archive,'',{flag:'wx',mode:0o600});
const pgEnv={...process.env,PGHOST:u.hostname,PGPORT:u.port||'5432',PGDATABASE:'jamloom_stage_20261108',PGUSER:decodeURIComponent(u.username),PGPASSWORD:decodeURIComponent(u.password),PGSSLMODE:'require'};
const dump=spawnSync('/opt/homebrew/opt/postgresql@18/bin/pg_dump',['--format=custom','--no-owner','--no-acl','--file',archive.pathname],{env:pgEnv,encoding:'utf8',timeout:120000});assert.equal(dump.status,0,'Private staging backup failed');await chmod(archive,0o600);
const inspect=spawnSync('/opt/homebrew/opt/postgresql@18/bin/pg_restore',['--list',archive.pathname],{encoding:'utf8',timeout:15000});assert.equal(inspect.status,0);assert(inspect.stdout.includes('cloud_capacity_cycles'));assert(inspect.stdout.includes('wallet_ledger_entries'));
const original=new URL(process.env.DATABASE_URL_UNPOOLED??process.env.DATABASE_URL!);assert.equal(original.pathname,'/neondb');assert.equal(original.hostname,u.hostname);
const admin=createPool(original.href);try{const before=(await read('staging-db-claimed.json')).before;const production=(await admin.query('SELECT (SELECT count(*)::int FROM dna_song_jobs) songs,(SELECT count(*)::int FROM wallet_ledger_entries) ledger')).rows[0];assert.deepEqual(production,before);await admin.query('DROP DATABASE "jamloom_stage_20261108" WITH (FORCE)');assert.equal((await admin.query('SELECT 1 FROM pg_database WHERE datname=$1',['jamloom_stage_20261108'])).rowCount,0);const after=(await admin.query('SELECT (SELECT count(*)::int FROM dna_song_jobs) songs,(SELECT count(*)::int FROM wallet_ledger_entries) ledger')).rows[0];assert.deepEqual(after,before);const bytes=await readFile(archive);const report={status:'PASS',at:new Date().toISOString(),temporaryDatabaseRemoved:true,productionCountsUnchanged:true,privateBackupPreserved:true,backupSHA256:createHash('sha256').update(bytes).digest('hex'),backupBytes:bytes.length,backupContentsListed:true,restoreTest:'NOT RUN; isolated test data only',stagingRows:counts};await writeFile(new URL('staging-database-retired.json',dir),JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report));}finally{await admin.end();}
