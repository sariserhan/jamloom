import {control,health,endpoint,database,read,save} from './deployed-common.mts';
const permit=await read('permit.json'),pool=database();try{const e=await control('serverless/'+endpoint),h=await health(),cycles=await pool.query('SELECT state,starts_at,expires_at,cap_micros,reason FROM cloud_capacity_cycles WHERE permit_id=$1 ORDER BY starts_at',[permit.id]),guard=await pool.query('SELECT checked_at FROM cloud_capacity_guardians WHERE endpoint=$1',[endpoint]);const inventoryResponse=await fetch('https://rest.runpod.io/v1/pods?includeWorkers=true&endpointId='+endpoint,{headers:{Authorization:'Bearer '+process.env.RUNPOD_API_KEY},signal:AbortSignal.timeout(15000)});if(!inventoryResponse.ok)throw Error('Inventory read failed');const inventory=await inventoryResponse.json();const workers=inventory.map((v:any)=>({id:v.id,desiredStatus:v.desiredStatus,lastStatusChange:v.lastStatusChange}));let seen:any[]=[];try{seen=await read('observed-workers.json');}catch{}for(const w of workers)if(!seen.some(x=>x.id===w.id))seen.push(w);await save('observed-workers.json',seen);const report={workers,at:new Date().toISOString(),workerLimits:e.workers,health:h,cycles:cycles.rows,guardianAgeMs:guard.rows[0]?Date.now()-Number(guard.rows[0].checked_at):null,permitExpiresAt:new Date(permit.expiresAt).toISOString()};await save('observation.json',report);console.log(JSON.stringify(report,(_k,v)=>typeof v==='bigint'?v.toString():v));}finally{await pool.end();}
