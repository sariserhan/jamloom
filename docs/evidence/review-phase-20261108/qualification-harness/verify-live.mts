import {readFile,writeFile} from 'node:fs/promises';import {createHash,randomUUID} from 'node:crypto';import assert from 'node:assert/strict';
import {database,read,save,delay,health,control,endpoint} from './deployed-common.mts';import {Wallet} from '../apps/site/lib/wallet';import {validateWav} from '../apps/site/lib/audio-validation';
const plan=JSON.parse(await readFile(new URL('../docs/evidence/review-phase-20261108/approved-plan.json',import.meta.url),'utf8'));assert.equal(plan.status,'APPROVED');assert.equal(plan.additionalMaxUSD,7.5);
const permit=await read('permit.json'),pool=database(),base='https://www.jamloom.com',account=JSON.parse(await readFile(new URL('../build-release-closure-20261031/review-account-private.json',import.meta.url),'utf8'));
const path='/api/improvise/song';const report:any={status:'RUNNING',startedAt:new Date().toISOString(),prepareCalls:0,submitCalls:0};let cookies='',id='';let deadline=Date.now()+38*60000;
const hash=(b:Buffer)=>createHash('sha256').update(b).digest('hex');
async function raw(path:string,body?:any,method?:string){assert(Date.now()<deadline);const r=await fetch(base+path,{method:method??(body?'POST':'GET'),headers:{Origin:base,'Content-Type':'application/json','x-jamloom-dna':'1',...(cookies?{Cookie:cookies}:{})},body:body?JSON.stringify(body):undefined,redirect:'manual',signal:AbortSignal.timeout(30000)});if(r.headers.getSetCookie().length)cookies=r.headers.getSetCookie().map(x=>x.split(';')[0]).join('; ');return r;}
async function api(path:string,body?:any,method?:string){const r=await raw(path,body,method);const j=await r.json();if(!r.ok)throw Error(path.split('?')[0]+' HTTP '+r.status+' '+(j.error??'Request failed'));return j;}
try{
 const signed=await api('/api/auth/sign-in/email',{email:account.email,password:account.password,rememberMe:false});assert.equal(signed.user.id,account.id);assert.equal((await api('/api/account')).sandboxReview,true);
 report.beforeTest=await new Wallet(pool,false).balance(account.id);report.beforeLive=await new Wallet(pool,true).balance(account.id);assert(report.beforeTest.available>=10);assert.equal(report.beforeTest.reserved,0);
 for(const p of [path,'/api/taste/song']){const r=await fetch(base+p);assert.equal(r.status,200);assert.equal((await r.json()).available,false);}
 const pre=await api(path);assert.equal(pre.available,false);assert.equal(pre.signedIn,true);assert(!pre.active);
 await writeFile(new URL('live-check-claimed.json',import.meta.url),JSON.stringify({at:new Date().toISOString(),maxPrepareCalls:1,maxSubmits:1,permit:permit.id}),{flag:'wx',mode:0o600});
 report.prepareCalls=1;await save('live-check-state.json',report);const prep=await api(path,{action:'prepare'});assert.equal(prep.creditsUsed,0);assert.equal(prep.state,'preparing');assert.deepEqual(await new Wallet(pool,false).balance(account.id),report.beforeTest);
 const readyUntil=Date.now()+20*60000;let ready=false;while(Date.now()<readyUntil){const state=await api(path);if(state.available){ready=true;break;}const cycle=(await pool.query('SELECT state,reason FROM cloud_capacity_cycles WHERE permit_id=$1 ORDER BY starts_at DESC LIMIT 1',[permit.id])).rows[0];assert(cycle&&!['stopped','stopping'].includes(cycle.state),'Preparation stopped');report.capacityState=cycle.state;report.observedAt=new Date().toISOString();await save('live-check-state.json',report);await delay(10000);}
 assert(ready,'Review capacity did not become ready within 20 minutes');report.readyAt=new Date().toISOString();await save('live-check-state.json',report);console.log('Review account capacity ready');
 const audio=await readFile(new URL('../renders/neural-question-input-20261030/source-16k-mono.wav',import.meta.url));assert.equal(hash(audio),'fd7752a9aead13dcbb15c6313e4834820bfecbf68160196ac9ca59deff9d0ea1');
 const uploaded=await api(path,{action:'upload',bytes:audio.length,sha256:hash(audio),consent:true});const target=new URL(uploaded.url);assert(target.protocol==='https:'&&target.hostname.endsWith('.r2.cloudflarestorage.com'));report.sourceId=uploaded.id;
 const put=await fetch(target,{method:'PUT',body:new Uint8Array(audio),headers:{'Content-Type':'audio/wav'},signal:AbortSignal.timeout(30000)});assert(put.ok);
 const input={profile:{sourceId:uploaded.id,phrase:'',voice:'male',genre:'drumandbass',consent:true},visibility:'private',publicConsent:false};const q=await api(path,{action:'quote',...input});assert.equal(q.credits,10);assert.equal(q.costCapMicros,68400);
 id=randomUUID().replaceAll('-','');report.requestId=id;report.submitCalls=1;await save('live-check-state.json',report);const submitted=await api(path,{action:'submit',requestId:id,token:q.token,...input});assert.equal(submitted.id,id);
 const jobUntil=Math.min(deadline,Date.now()+7*60000);let state:any;while(Date.now()<jobUntil){state=await api(path+'?id='+id);if(['completed','failed','cancelled'].includes(state.state))break;await delay(5000);}assert.equal(state.state,'completed');
 const row=(await pool.query('SELECT d.*,c.execution_ms,c.delay_ms,c.estimated_cost_micros,c.payload FROM dna_song_jobs d JOIN cloud_song_runs c ON c.id=d.id WHERE d.id=$1',[id])).rows[0];assert.equal(row.owner_id,account.id);assert.equal(row.billing_live,false);assert.equal(row.visibility,'private');
 const redirect=await raw(path+'?id='+id+'&file=audio&download=1');assert.equal(redirect.status,307);const location=new URL(redirect.headers.get('location')!);assert(location.protocol==='https:'&&location.hostname.endsWith('.r2.cloudflarestorage.com'));const dl=await fetch(location,{signal:AbortSignal.timeout(30000)});assert(dl.ok);const output=Buffer.from(await dl.arrayBuffer());assert.equal(hash(output),row.audio_sha256);assert.equal(validateWav(output,Number(row.audio_bytes),row.audio_sha256,26880044),row.payload.duration_seconds*1000);await writeFile(new URL('review-check-private.wav',import.meta.url),output,{mode:0o600});
 report.result={state:'completed',credits:10,seconds:row.payload.duration_seconds,bytes:output.length,sha256:hash(output),executionMs:Number(row.execution_ms),estimatedCostMicros:Number(row.estimated_cost_micros),visibility:'private'};
 for(const suffix of ['', '&file=audio']){const r=await fetch(base+path+'?id='+id+suffix,{redirect:'manual'});assert([401,403,404,503].includes(r.status));assert(!r.headers.get('location'));}report.privateAudioProtected=true;
 report.afterTest=await new Wallet(pool,false).balance(account.id);report.afterLive=await new Wallet(pool,true).balance(account.id);assert.equal(report.afterTest.available,report.beforeTest.available-10);assert.equal(report.afterTest.reserved,0);assert.deepEqual(report.afterLive,report.beforeLive);
 const idleUntil=Date.now()+180000;let stopped=false;while(Date.now()<idleUntil){const h=await health();const cycle=(await pool.query('SELECT state FROM cloud_capacity_cycles WHERE permit_id=$1 ORDER BY starts_at DESC LIMIT 1',[permit.id])).rows[0];if(cycle.state==='stopped'&&Object.values(h.workers).every(v=>v===0)&&h.jobs.inQueue+h.jobs.inProgress===0){stopped=true;break;}await delay(5000);}assert(stopped,'Automatic idle shutdown missing');report.idleShutdown=true;report.status='PASS';
}catch(e){report.status='FAIL';report.error=(e as Error).message;
 if(id){try{await api(path+'?id='+id,undefined,'DELETE');}catch{}}
 await control('serverless/'+endpoint,{workers:{min:0,max:0}});report.emergencyStopRequested=true;
}finally{try{await api('/api/auth/sign-out',{});}catch{}report.finishedAt=new Date().toISOString();await save('live-check-result.json',report);await pool.end();console.log(JSON.stringify(report,(_k,v)=>typeof v==='bigint'?v.toString():v));}
