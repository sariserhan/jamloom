import {database,save} from './deployed-common.mts';import {readFile} from 'node:fs/promises';import assert from 'node:assert/strict';
const settings=JSON.parse(await readFile(new URL('review-environment-private.json',import.meta.url),'utf8'));assert.equal(settings.JAMLOOM_CLOUD_SONGS_ENABLED,'false');assert.equal(settings.JAMLOOM_CREDIT_PURCHASES_ENABLED,'false');assert.equal(settings.JAMLOOM_AI_DJ_ENABLED,'false');assert.equal(settings.JAMLOOM_CREDIT_COST_QUALIFICATION,'held');
const routes=[];for(const path of ['/api/taste/song','/api/improvise/song']){const r=await fetch('https://www.jamloom.com'+path,{signal:AbortSignal.timeout(20000)});assert.equal(r.status,200);assert.equal((await r.json()).available,false);routes.push({path,status:200,available:false});}
const pool=database();try{const trials=await pool.query('SELECT max_claims FROM credit_trial_budgets WHERE billing_live=true');assert.equal(Number(trials.rows[0].max_claims),0);const r={status:'PASS',at:new Date().toISOString(),routes,liveTrialAccountLimit:0,reviewAccounts:2,publicPurchases:false,publicGeneration:false,costQualification:false,creditPricesChanged:false};await save('public-holds.json',r);console.log(JSON.stringify(r));}finally{await pool.end();}
