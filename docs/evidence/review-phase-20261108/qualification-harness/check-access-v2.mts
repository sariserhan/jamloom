import {stagingRequest} from './staging-request-v2.mts';import {readFile} from 'node:fs/promises';import {save} from './deployed-common.mts';import assert from 'node:assert/strict';
const account=JSON.parse(await readFile(new URL('../build-release-closure-20261031/review-account-private.json',import.meta.url),'utf8'));
const anon=[];for(const path of ['/api/taste/song','/api/improvise/song']){const r=await stagingRequest(path);assert.equal(r.status,200);const j=await r.json();assert.equal(j.available,false);anon.push({path,available:false});}
const r=await stagingRequest('/api/auth/sign-in/email',{method:'POST',headers:{Origin:'https://www.jamloom.com','Content-Type':'application/json'},body:JSON.stringify({email:account.email,password:account.password,rememberMe:false})});assert.equal(r.status,200);assert.equal((await r.json()).user.id,account.id);const cookie=r.headers.getSetCookie().map(x=>x.split(';')[0]).join('; ');assert(cookie);const headers={Origin:'https://www.jamloom.com','Content-Type':'application/json',Cookie:cookie};
const me=await stagingRequest('/api/account',{headers});assert.equal(me.status,200);const a=await me.json();assert.equal(a.sandboxReview,true);const song=await stagingRequest('/api/improvise/song',{headers});assert.equal(song.status,200);const s=await song.json();assert.equal(s.signedIn,true);assert.equal(s.mode,'cloud');const out=await stagingRequest('/api/auth/sign-out',{method:'POST',headers,body:'{}'});assert.equal(out.status,200);const report={status:'PASS',at:new Date().toISOString(),anonymous:anon,reviewAuthenticated:true,sandboxReview:true,reviewAvailability:s.available===true,generationSubmissions:0};await save('candidate-v2-access.json',report);console.log(JSON.stringify(report));
