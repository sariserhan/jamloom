import {database,read,save,control,health,endpoint} from './deployed-common.mts';import {readFile} from 'node:fs/promises';import {createHash} from 'node:crypto';import assert from 'node:assert/strict';import {Wallet} from '../apps/site/lib/wallet';
const permit=await read('permit.json'),result=await read('live-check-result.json'),pool=database();try{
 const e=await control('serverless/'+endpoint),h=await health();assert.deepEqual(e.workers,{min:0,max:0});assert.equal(h.jobs.inQueue+h.jobs.inProgress,0);assert(Object.values(h.workers).every(x=>x===0));const resp=await fetch('https://rest.runpod.io/v1/pods?includeWorkers=true&endpointId='+endpoint,{headers:{Authorization:'Bearer '+process.env.RUNPOD_API_KEY},signal:AbortSignal.timeout(20000)});assert(resp.ok);assert.deepEqual(await resp.json(),[]);
 const row=(await pool.query('SELECT d.owner_id,d.state,d.billing_live,d.visibility,d.audio_sha256,d.audio_bytes,c.cleanup_at,c.source_id FROM dna_song_jobs d JOIN cloud_song_runs c ON c.id=d.id WHERE d.id=$1',[result.requestId])).rows[0];assert.equal(row.state,'completed');assert.equal(row.billing_live,false);assert.equal(row.visibility,'private');const audio=await readFile(new URL('review-check-private.wav',import.meta.url));assert.equal(createHash('sha256').update(audio).digest('hex'),row.audio_sha256);assert.equal(audio.length,Number(row.audio_bytes));
 const test=await new Wallet(pool,false).balance(row.owner_id),live=await new Wallet(pool,true).balance(row.owner_id);assert.deepEqual(test,result.afterTest);assert.deepEqual(live,result.afterLive);
 const cycles=(await pool.query('SELECT state,reason,cap_micros FROM cloud_capacity_cycles WHERE permit_id=$1 ORDER BY starts_at',[permit.id])).rows;assert.equal(cycles.length,2);assert(cycles.every(r=>r.state==='stopped'));assert.equal(cycles[0].reason,'idle');
 const reserved=Number((await pool.query('SELECT reserved_micros FROM cloud_capacity_permits WHERE id=$1',[permit.id])).rows[0].reserved_micros);assert.equal(reserved,1500000);const guard=(await pool.query('SELECT checked_at FROM cloud_capacity_guardians WHERE endpoint=$1',[endpoint])).rows[0];const guardianAgeMs=Date.now()-Number(guard.checked_at);assert(guardianAgeMs>=0&&guardianAgeMs<90000);
 const report={status:'PASS',at:new Date().toISOString(),workerLimits:[0,0],workerInventory:[],queuedJobs:0,runningJobs:0,liveWalletUnchanged:true,heldTestCredits:test.reserved,privateCompletedAudioVerified:true,temporarySourceCleanupRecorded:!!row.cleanup_at,cycles:cycles.map(r=>({state:r.state,reason:r.reason,reservedMicros:Number(r.cap_micros)})),permitReservedMicros:reserved,permitRemainingMicros:permit.capMicros-reserved,guardianAgeMs,guardianActiveForReview:true,reviewAccessExpiresAt:new Date(permit.expiresAt).toISOString(),publicLaunch:false};await save('final-readback.json',report);console.log(JSON.stringify(report));
}finally{await pool.end();}
