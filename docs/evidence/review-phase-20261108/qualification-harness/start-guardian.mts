import {read,save,control,health,endpoint,database} from './deployed-common.mts';import {remoteGuardian} from './remote-guardian.mts';import {capacityLease} from '../apps/site/lib/cloud-capacity-permit';import {assertProductionEndpoint,CLOUD_COST_PROFILE} from '../apps/site/lib/cloud-production-profile';import assert from 'node:assert/strict';
const permit=await read('permit.json'),before=await control('serverless/'+endpoint),h=await health();assert.deepEqual(before.workers,{min:0,max:0});assert.equal(h.jobs.inQueue+h.jobs.inProgress,0);assert(Object.values(h.workers).every(x=>x===0));const catalog=await control('catalog/gpus');
const gpu={...before.gpu,count:1,pools:['AMPERE_24'],excludedTypes:catalog.gpus.filter((g:any)=>g.pool==='AMPERE_24'&&g.id!=='NVIDIA L4').map((g:any)=>g.id)};assertProductionEndpoint({...before,gpu,workers:{min:1,max:1}},catalog,capacityLease(permit,Date.now()),CLOUD_COST_PROFILE);
await save('endpoint-before-private.json',before);const updated=await control('serverless/'+endpoint,{gpu,workers:{min:0,max:0}});assert.deepEqual(updated.workers,{min:0,max:0});await remoteGuardian('start',permit);
const pool=database();try{for(let n=0;n<20;n++){const r=(await pool.query('SELECT checked_at FROM cloud_capacity_guardians WHERE endpoint=$1',[endpoint])).rows[0];if(r&&Number(r.checked_at)>permit.startsAt){console.log('PASS remote guardian heartbeat; no GPU started');await save('guardian-ready.json',{status:'PASS',at:new Date().toISOString(),productionDatabase:true,providerWorkers:[0,0],maxUSD:7.5,expiresAt:new Date(permit.expiresAt).toISOString()});break;}assert(n<19);await new Promise(r=>setTimeout(r,1000));}}finally{await pool.end();}
