{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/ignore-build.mjs",
  "crons": [
    {"path":"/api/maintenance","schedule":"0 * * * *"},
    {"path":"/api/song-jobs","schedule":"* * * * *"},
    {
      "path": "/api/notifications",
      "schedule": "*/5 * * * *"
    },
    {"path":"/api/ai-dj/supervisor","schedule":"* * * * *"}
  ],
  "git": {
    "deploymentEnabled": {
      "codex/runpod-setup": false
    }
  }
}
