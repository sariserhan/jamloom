{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/ignore-build.mjs",
  "crons": [
    {
      "path": "/api/operations",
      "schedule": "0,30 * * * *"
    },
    {
      "path": "/api/maintenance",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/song-jobs",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/notifications",
      "schedule": "0,30 * * * *"
    },
    {
      "path": "/api/ai-dj/supervisor",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/finance/apple",
      "schedule": "0 13 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "codex/runpod-setup": false
    }
  }
}
